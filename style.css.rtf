\f0\fs24 \cf0 * \{\
    margin: 0;\
    padding: 0;\
    box-sizing: border-box;\
\}\
\
body \{\
    font-family: "Inter", sans-serif;\
    background: #080808;\
    color: white;\
    min-height: 100vh;\
    padding: 30px;\
\}\
\
/* Main Bento Grid */\
\
.dashboard \{\
    max-width: 1400px;\
    margin: auto;\
\
    display: grid;\
\
    grid-template-columns:\
        repeat(4, 1fr);\
\
    grid-template-rows:\
        260px\
        200px\
        240px;\
\
    gap: 16px;\
\}\
\
\
/* Common Card */\
\
.card \{\
    background: #151515;\
    border: 1px solid #292929;\
    border-radius: 24px;\
\
    padding: 24px;\
\
    position: relative;\
    overflow: hidden;\
\
    transition: 0.3s ease;\
\}\
\
.card:hover \{\
    transform: translateY(-5px);\
    border-color: #e10600;\
    box-shadow: 0 15px 40px rgba(225, 6, 0, 0.15);\
\}\
\
\
/* Card Label */\
\
.card-label \{\
    color: #888;\
    font-size: 11px;\
    font-weight: 800;\
    letter-spacing: 2px;\
    margin-bottom: 18px;\
\}\
\
\
/* Driver Card */\
\
.driver-card \{\
    grid-column: span 2;\
    background:\
        linear-gradient(\
            135deg,\
            #181818,\
            #0d0d0d\
        );\
\}\
\
.driver-content \{\
    display: flex;\
    justify-content: space-between;\
    align-items: center;\
    height: 190px;\
\}\
\
.driver-number \{\
    color: #e10600;\
    font-size: 20px;\
    font-weight: 900;\
\}\
\
.driver-card h1 \{\
    font-size: 40px;\
    line-height: 0.95;\
    margin: 8px 0;\
    font-weight: 900;\
\}\
\
.team \{\
    color: #888;\
    font-size: 11px;\
    letter-spacing: 1px;\
\}\
\
.helmet \{\
    font-size: 100px;\
    transform: rotate(-10deg);\
\}\
\
\
/* Car Card */\
\
.car-card \{\
    grid-column: span 1;\
    grid-row: span 2;\
\
    background:\
        radial-gradient(\
            circle at center,\
            #3b0909,\
            #151515 65%\
        );\
\}\
\
.car-info h2 \{\
    font-size: 30px;\
    font-weight: 900;\
\}\
\
.car-info p \{\
    color: #888;\
    font-size: 12px;\
    margin-top: 5px;\
\}\
\
.car-shape \{\
    font-size: 95px;\
    text-align: center;\
    margin-top: 55px;\
    transform: rotate(-5deg);\
\}\
\
.car-specs \{\
    position: absolute;\
    bottom: 20px;\
    left: 24px;\
    right: 24px;\
\
    display: flex;\
    justify-content: space-between;\
\}\
\
.car-specs div \{\
    display: flex;\
    flex-direction: column;\
\}\
\
.car-specs strong \{\
    font-size: 16px;\
\}\
\
.car-specs span \{\
    color: #777;\
    font-size: 8px;\
    margin-top: 3px;\
\}\
\
\
/* Race Card */\
\
.race-card \{\
    grid-column: span 1;\
\}\
\
.race-card h2 \{\
    font-size: 25px;\
    line-height: 1;\
    font-weight: 900;\
\}\
\
.race-date \{\
    display: flex;\
    align-items: center;\
    gap: 10px;\
    margin-top: 20px;\
\}\
\
.race-date span \{\
    font-size: 42px;\
    font-weight: 900;\
    color: #e10600;\
\}\
\
.race-date div \{\
    display: flex;\
    flex-direction: column;\
\}\
\
.race-date strong \{\
    font-size: 14px;\
\}\
\
.race-date small \{\
    color: #777;\
\}\
\
.circuit \{\
    color: #777;\
    font-size: 11px;\
    margin-top: 15px;\
\}\
\
\
/* Championship */\
\
.championship-card \{\
    grid-column: span 1;\
\}\
\
.championship-number \{\
    font-size: 60px;\
    color: #e10600;\
    font-weight: 900;\
\}\
\
.championship-card p \{\
    color: #777;\
    font-size: 10px;\
    letter-spacing: 2px;\
\}\
\
.points \{\
    margin-top: 15px;\
\}\
\
.points strong \{\
    font-size: 25px;\
\}\
\
.points span \{\
    color: #777;\
    font-size: 10px;\
    margin-left: 5px;\
\}\
\
\
/* Lap Card */\
\
.lap-card \{\
    grid-column: span 1;\
\}\
\
.lap-card h2 \{\
    font-size: 34px;\
    margin-top: 30px;\
\}\
\
.lap-bottom \{\
    display: flex;\
    justify-content: space-between;\
\
    position: absolute;\
    bottom: 20px;\
    left: 24px;\
    right: 24px;\
\
    color: #888;\
    font-size: 10px;\
\}\
\
\
/* Stats Card */\
\
.stats-card \{\
    grid-column: span 2;\
\}\
\
.stats-grid \{\
    display: grid;\
    grid-template-columns: repeat(4, 1fr);\
    gap: 10px;\
    margin-top: 30px;\
\}\
\
.stat \{\
    border-left: 2px solid #e10600;\
    padding-left: 15px;\
\
    display: flex;\
    flex-direction: column;\
\}\
\
.stat strong \{\
    font-size: 30px;\
    font-weight: 900;\
\}\
\
.stat span \{\
    color: #777;\
    font-size: 9px;\
    margin-top: 5px;\
\}\
\
\
/* Performance */\
\
.performance-card \{\
    grid-column: span 2;\
\}\
\
.performance \{\
    display: flex;\
    flex-direction: column;\
    gap: 13px;\
    margin-top: 10px;\
\}\
\
.performance-row \{\
    display: grid;\
    grid-template-columns: 90px 1fr 35px;\
    align-items: center;\
    gap: 10px;\
\
    font-size: 9px;\
\}\
\
.performance-row span \{\
    color: #888;\
\}\
\
.performance-row strong \{\
    font-size: 10px;\
\}\
\
.bar \{\
    height: 6px;\
    background: #292929;\
    border-radius: 10px;\
    overflow: hidden;\
\}\
\
.fill \{\
    height: 100%;\
    background: #e10600;\
    border-radius: 10px;\
\}\
\
.speed \{\
    width: 96%;\
\}\
\
.downforce \{\
    width: 91%;\
\}\
\
.handling \{\
    width: 94%;\
\}\
\
.power \{\
    width: 98%;\
\}\
\
\
/* Progress */\
\
.progress-card \{\
    grid-column: span 1;\
\}\
\
.progress-number \{\
    display: flex;\
    align-items: baseline;\
    gap: 8px;\
\}\
\
.progress-number strong \{\
    font-size: 50px;\
    color: #e10600;\
    font-weight: 900;\
\}\
\
.progress-number span \{\
    color: #777;\
    font-size: 10px;\
\}\
\
.progress-bar \{\
    width: 100%;\
    height: 8px;\
    background: #292929;\
    border-radius: 10px;\
    margin-top: 25px;\
    overflow: hidden;\
\}\
\
.progress-bar div \{\
    width: 72%;\
    height: 100%;\
    background: #e10600;\
\}\
\
.progress-card p \{\
    color: #777;\
    font-size: 10px;\
    margin-top: 10px;\
\}\
\
\
/* ========================= */\
/* TABLET */\
/* ========================= */\
\
@media (max-width: 1000px) \{\
\
    body \{\
        padding: 20px;\
    \}\
\
    .dashboard \{\
        grid-template-columns: repeat(2, 1fr);\
        grid-template-rows: auto;\
    \}\
\
    .driver-card,\
    .stats-card,\
    .performance-card \{\
        grid-column: span 2;\
    \}\
\
    .car-card \{\
        grid-row: span 1;\
    \}\
\}\
\
\
/* ========================= */\
/* MOBILE */\
/* ========================= */\
\
@media (max-width: 600px) \{\
\
    body \{\
        padding: 12px;\
    \}\
\
    .dashboard \{\
        display: grid;\
        grid-template-columns: 1fr;\
        gap: 12px;\
    \}\
\
    .card,\
    .driver-card,\
    .car-card,\
    .race-card,\
    .championship-card,\
    .lap-card,\
    .stats-card,\
    .performance-card,\
    .progress-card \{\
        grid-column: span 1;\
        grid-row: span 1;\
    \}\
\
    .card \{\
        min-height: 210px;\
        padding: 20px;\
        border-radius: 20px;\
    \}\
\
    .driver-card \{\
        min-height: 280px;\
    \}\
\
    .driver-card h1 \{\
        font-size: 32px;\
    \}\
\
    .helmet \{\
        font-size: 70px;\
    \}\
\
    .car-card \{\
        min-height: 300px;\
    \}\
\
    .car-shape \{\
        font-size: 80px;\
        margin-top: 45px;\
    \}\
\
    .stats-grid \{\
        grid-template-columns: repeat(2, 1fr);\
        gap: 20px;\
    \}\
\
    .performance-row \{\
        grid-template-columns: 80px 1fr 30px;\
    \}\
\}}